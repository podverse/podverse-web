#####
##### podverse-web
##### local

#####
##### API Configuration
#####
NEXT_PUBLIC_SSR_API_PROTOCOL=http
# Use host.docker.internal to access host machine from Docker container
NEXT_PUBLIC_SSR_API_HOST=host.docker.internal
NEXT_PUBLIC_SSR_API_PORT=1234

NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PORT=1234

NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v2

#####
##### Web Configuration
#####
NEXT_PUBLIC_WEB_PROTOCOL=http
NEXT_PUBLIC_WEB_DOMAIN=localhost:3000
NEXT_PUBLIC_BRAND_NAME=Podverse
NEXT_PUBLIC_POLLING_INTERVAL_MS=3000

#####
##### Lightning Keysend
#####
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_NAME=Podverse
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_TYPE=node
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_ADDRESS=fake9f91a0cb8ff43840e3c322c4c61f019d8c1c3cea15a25cfc425ac605e61a4a
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_CUSTOM_KEY=123456
NEXT_PUBLIC_APP_VALUE_LIGHTNING_KEYSEND_CUSTOM_VALUE=fakefnRSUQlwKfzLEoB3

#####
##### Website Features
#####
# blank defaults to "all-available"
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES= 
# blank defaults to "en"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE=

#####
##### Web Push (Native)
#####
# Native browser push notifications using W3C Push API (no third-party dependency)
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=

#####
##### Account / Membership
#####
# "sign-up" for paid premium memberships
# "sign-up" plus set costs to 0 for free sign ups (see api .env.example)
# "contact-only" for contact-only signup mode
NEXT_PUBLIC_ACCOUNT_SIGNUP_MODE=paid

#####
##### Contact & Social Media Links
#####
# Contact email address used for contact page mailto links
NEXT_PUBLIC_CONTACT_EMAIL=contact@podverse.fm
# URLs for social media platforms displayed in the footer and contact page
# Leave empty to hide a particular social media link
NEXT_PUBLIC_SOCIAL_ACTIVITY_PUB=https://podcastindex.social/web/@podverse
NEXT_PUBLIC_SOCIAL_DISCORD=https://discord.gg/6HkyNKR
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/podverse
# surround with "" to prevent # symbol from being treated as a comment
NEXT_PUBLIC_SOCIAL_MATRIX="https://matrix.to/#/#podverse-space:matrix.org"
NEXT_PUBLIC_SOCIAL_X=https://x.com/podverse

#####
##### Server Environment
#####
# Environment indicator for the disclaimer modal
NEXT_PUBLIC_SERVER_ENV=alpha # alpha, beta, prod

#####
##### Local Development Only
#####
# DO NOT USE IN PRODUCTION
OPENAI_API_KEY=
