# Lighthouse QA Test Suite Environment Variables
# Copy this file to .env and update with your values

# Database Configuration (Test Database - port 5111)
# The test database runs in a Docker container (podverse_test_db) on port 5111
# This is separate from the development database on port 5432
DB_HOST=localhost
DB_PORT=5111
DB_DATABASE=postgres
DB_READ_USERNAME=read
DB_READ_PASSWORD=
DB_READ_WRITE_USERNAME=read_write
DB_READ_WRITE_PASSWORD=

# This overrides the production restriction on localhost proxy URLs
# Set automatically by Lighthouse test suite - only needed if manually running with NODE_ENV=production
ALLOW_LOCALHOST_PROXY=true

# Optional: API JWT Secret (auto-generated if not provided)
# AUTH_JWT_SECRET=

# Optional: Log Level (default: info)
# LOG_LEVEL=info

# Optional: Lighthouse Consistency Controls
# Number of runs per scenario - median is used (default: 5)
# LIGHTHOUSE_MEDIAN_RUNS=5

# Browser context mode: 'fresh' (new context per run) or 'single' (reuse context, clear cache)
# Default: fresh
# LIGHTHOUSE_CONTEXT_MODE=fresh

# Note: OPENAI_API_KEY is loaded from ../../.env.openai (podverse-web/.env.openai)
# for generating comparison summaries. Ensure that file exists with your OpenAI API key.
